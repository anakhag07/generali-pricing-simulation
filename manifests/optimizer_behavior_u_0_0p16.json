    "t_steps": 100,
    "n_grad_samples": 8,
    "enabled_estimators": ["first_order"],
    "plot": false,
    "verbose": false,
    "wandb_enabled": false
  },
  "seeds": {
    "run_seeds": [8],
    "anchor_seed": 8,
    "vary": ["theta"]
