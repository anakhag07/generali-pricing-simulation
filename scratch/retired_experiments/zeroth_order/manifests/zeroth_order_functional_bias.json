      {"label": "linear-alpha-0.1", "value": "linear:0.1", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "LinearThetaBias", "alpha": 0.1}}]}},
      {"label": "linear-alpha-0.2", "value": "linear:0.2", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "LinearThetaBias", "alpha": 0.2}}]}},

      {"label": "arctan-alpha-0", "value": "arctan:0", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "ArctanThetaBias", "alpha": 0.0}}]}},
      {"label": "arctan-alpha-0.025", "value": "arctan:0.025", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "ArctanThetaBias", "alpha": 0.025}}]}},
      {"label": "arctan-alpha-0.05", "value": "arctan:0.05", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "ArctanThetaBias", "alpha": 0.05}}]}},
      {"label": "arctan-alpha-0.1", "value": "arctan:0.1", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "ArctanThetaBias", "alpha": 0.1}}]}},
      {"label": "arctan-alpha-0.2", "value": "arctan:0.2", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "ArctanThetaBias", "alpha": 0.2}}]}},

      {"label": "remainder-alpha-0", "value": "remainder:0", "overrides": {"objective_modifications": [{"type": "theta_bias", "bias": {"type": "ArctanRemainderThetaBias", "alpha": 0.0}}]}},
